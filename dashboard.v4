<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard Booking MUA</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --pink: #D4537E;
      --pink-light: rgba(212, 83, 126, 0.08);
      --pink-focus: rgba(212, 83, 126, 0.15);
      --text-primary: #1a1a1a;
      --text-secondary: #6b6b6b;
      --border: #e0e0e0;
      --bg: #fff;
      --bg-soft: #fafaf9;
      --success-bg: rgba(59,109,17,0.07);
      --success-border: rgba(59,109,17,0.25);
      --success-text: #2d5a0a;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg-soft);
      color: var(--text-primary);
      min-height: 100vh;
    }

    /* ── HEADER ── */
    .dashboard-header {
      background: var(--bg);
      border-bottom: 0.5px solid var(--border);
      padding: 1.5rem 2rem;
      box-shadow: 0 1px 4px rgba(0,0,0,0.02);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .header-content {
      max-width: 1400px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1.5rem;
    }

    .header-title {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .header-title h1 {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 28px;
      font-weight: 300;
      font-style: italic;
      color: var(--text-primary);
    }

    .header-title span {
      display: inline-block;
      background: var(--pink);
      color: #fff;
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .header-controls {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .filter-group {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .filter-group label {
      font-size: 12px;
      font-weight: 500;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .filter-group select {
      padding: 8px 12px;
      border: 0.5px solid var(--border);
      border-radius: 6px;
      font-family: 'DM Sans', sans-serif;
      font-size: 13px;
      background: var(--bg);
      color: var(--text-primary);
      cursor: pointer;
      outline: none;
    }

    .filter-group select:hover { border-color: var(--pink); }
    .filter-group select:focus { border-color: var(--pink); box-shadow: 0 0 0 2px var(--pink-focus); }

    .btn-refresh {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      border: 0.5px solid var(--pink);
      background: var(--pink);
      color: #fff;
      border-radius: 6px;
      font-family: 'DM Sans', sans-serif;
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.2s;
    }

    .btn-refresh:hover { background: #bf4570; }
    .btn-refresh:active { transform: scale(0.98); }
    .btn-refresh.loading { opacity: 0.7; cursor: not-allowed; }
    .btn-refresh .spinner { width: 12px; height: 12px; border: 2px solid rgba(255,255,255,0.4); border-top-color: #fff; border-radius: 50%; animation: spin 0.6s linear infinite; }

    @keyframes spin { to { transform: rotate(360deg); } }

    .status-badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .status-pending {
      background: rgba(255,193,7,0.1);
      color: #f57f17;
      border: 0.5px solid rgba(255,193,7,0.3);
    }

    .status-confirmed {
      background: var(--success-bg);
      color: var(--success-text);
      border: 0.5px solid var(--success-border);
    }

    /* ── MAIN CONTENT ── */
    .dashboard-main {
      max-width: 1400px;
      margin: 0 auto;
      padding: 2rem;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .stat-card {
      background: var(--bg);
      border: 0.5px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }

    .stat-card-content h3 {
      font-size: 12px;
      font-weight: 500;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 8px;
    }

    .stat-card-value {
      font-size: 28px;
      font-weight: 600;
      color: var(--pink);
    }

    .stat-card-icon {
      font-size: 28px;
      color: var(--pink);
      opacity: 0.3;
    }

    /* Revenue breakdown di dalam stat card */
    .stat-breakdown {
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin-top: 8px;
      padding-top: 8px;
      border-top: 0.5px solid var(--border);
    }

    .stat-breakdown-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
    }

    .stat-breakdown-label {
      color: var(--text-secondary);
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .stat-breakdown-label::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .stat-breakdown-label.dp::before   { background: var(--pink); }
    .stat-breakdown-label.lunas::before { background: #2d5a0a; }

    .stat-breakdown-value {
      font-weight: 600;
      font-size: 11px;
    }

    .stat-breakdown-value.dp    { color: var(--pink); }
    .stat-breakdown-value.lunas { color: #2d5a0a; }

    /* ── TABLE ── */
    .bookings-section {
      background: var(--bg);
      border: 0.5px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0,0,0,0.02);
    }

    .bookings-header {
      padding: 1.5rem;
      border-bottom: 0.5px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .bookings-header h2 {
      font-size: 16px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .bookings-count {
      font-size: 12px;
      color: var(--text-secondary);
      background: var(--pink-light);
      padding: 4px 12px;
      border-radius: 6px;
    }

    .bookings-table {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    thead {
      background: var(--bg-soft);
      border-bottom: 0.5px solid var(--border);
    }

    th {
      padding: 12px 16px;
      text-align: left;
      font-weight: 600;
      color: var(--text-secondary);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    td {
      padding: 14px 16px;
      border-bottom: 0.5px solid var(--border);
      color: var(--text-primary);
    }

    tbody tr:hover {
      background: var(--pink-light);
      cursor: pointer;
    }

    .name-col { font-weight: 500; }
    .date-col { color: var(--text-secondary); }
    .price-col { font-weight: 600; color: var(--pink); }
    .paket-col { font-size: 12px; color: var(--text-secondary); }

    .btn-detail {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 6px 10px;
      background: transparent;
      border: 0.5px solid var(--border);
      border-radius: 4px;
      font-family: 'DM Sans', sans-serif;
      font-size: 11px;
      color: var(--pink);
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-detail:hover {
      background: var(--pink-light);
      border-color: var(--pink);
    }

    /* ── MODAL ── */
    .modal-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.4);
      z-index: 1000;
      animation: fadeIn 0.2s;
    }

    .modal-overlay.show { display: flex; align-items: center; justify-content: center; }

    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

    .modal-content {
      background: var(--bg);
      border-radius: 12px;
      max-width: 500px;
      width: 90%;
      max-height: 85vh;
      overflow-y: auto;
      animation: slideUp 0.3s;
    }

    @keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

    .modal-header {
      padding: 1.5rem;
      border-bottom: 0.5px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .modal-header h3 {
      font-size: 18px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .btn-close {
      background: transparent;
      border: none;
      font-size: 20px;
      color: var(--text-secondary);
      cursor: pointer;
    }

    .btn-close:hover { color: var(--text-primary); }

    .modal-body {
      padding: 1.5rem;
    }

    .detail-section {
      margin-bottom: 1.5rem;
    }

    .detail-section-title {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--pink);
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .detail-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding: 8px 0;
      border-bottom: 0.5px solid var(--border);
    }

    .detail-row:last-child { border-bottom: none; }

    .detail-label {
      font-size: 12px;
      color: var(--text-secondary);
      font-weight: 500;
    }

    .detail-value {
      font-size: 13px;
      color: var(--text-primary);
      font-weight: 500;
      text-align: right;
      max-width: 55%;
      word-break: break-word;
    }

    .detail-value.highlight { color: var(--pink); font-weight: 600; }

    .empty-state {
      text-align: center;
      padding: 3rem 2rem;
      color: var(--text-secondary);
    }

    .empty-state i { font-size: 48px; color: var(--border); margin-bottom: 1rem; display: block; opacity: 0.5; }

    /* ── MODAL FOOTER ── */
    .modal-footer {
      padding: 1rem 1.5rem;
      border-top: 0.5px solid var(--border);
      display: flex;
      justify-content: flex-end;
      gap: 8px;
    }

    .btn-invoice {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      background: transparent;
      color: var(--pink);
      border: 0.5px solid var(--pink);
      border-radius: 6px;
      font-family: 'DM Sans', sans-serif;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-invoice:hover { background: var(--pink-light); }

    .btn-edit {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      background: var(--pink);
      color: #fff;
      border: none;
      border-radius: 6px;
      font-family: 'DM Sans', sans-serif;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.2s;
    }

    .btn-edit:hover { background: #bf4570; }

    /* ── EDIT MODAL ── */
    .edit-modal-overlay {
      display: none;
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.5);
      z-index: 1100;
      animation: fadeIn 0.2s;
    }

    .edit-modal-overlay.show { display: flex; align-items: center; justify-content: center; }

    .edit-modal-content {
      background: var(--bg);
      border-radius: 12px;
      max-width: 560px;
      width: 94%;
      max-height: 90vh;
      overflow-y: auto;
      animation: slideUp 0.3s;
    }

    .edit-modal-header {
      padding: 1.25rem 1.5rem;
      border-bottom: 0.5px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      background: var(--bg);
      z-index: 1;
    }

    .edit-modal-header h3 {
      font-size: 16px;
      font-weight: 600;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .edit-modal-body { padding: 1.5rem; }

    .edit-section-title {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--pink);
      margin: 1.25rem 0 0.75rem;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .edit-section-title:first-child { margin-top: 0; }

    .edit-field { margin-bottom: 12px; }

    .edit-field label {
      display: block;
      font-size: 11px;
      font-weight: 600;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 5px;
    }

    .edit-field input,
    .edit-field select,
    .edit-field textarea {
      width: 100%;
      padding: 9px 12px;
      border: 0.5px solid var(--border);
      border-radius: 6px;
      font-family: 'DM Sans', sans-serif;
      font-size: 13px;
      color: var(--text-primary);
      background: var(--bg);
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .edit-field input:focus,
    .edit-field select:focus,
    .edit-field textarea:focus {
      border-color: var(--pink);
      box-shadow: 0 0 0 2px var(--pink-focus);
    }

    .edit-field textarea { resize: vertical; min-height: 60px; }

    .edit-fields-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .edit-modal-footer {
      padding: 1rem 1.5rem;
      border-top: 0.5px solid var(--border);
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      position: sticky;
      bottom: 0;
      background: var(--bg);
    }

    .btn-cancel-edit {
      padding: 8px 16px;
      border: 0.5px solid var(--border);
      background: transparent;
      border-radius: 6px;
      font-family: 'DM Sans', sans-serif;
      font-size: 13px;
      color: var(--text-secondary);
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-cancel-edit:hover { border-color: var(--text-secondary); color: var(--text-primary); }

    .btn-save-edit {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 18px;
      background: var(--pink);
      color: #fff;
      border: none;
      border-radius: 6px;
      font-family: 'DM Sans', sans-serif;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.2s;
    }

    .btn-save-edit:hover { background: #bf4570; }
    .btn-save-edit:disabled { opacity: 0.6; cursor: not-allowed; }

    /* Toast notif */
    .toast {
      position: fixed;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%) translateY(20px);
      background: #1a1a1a;
      color: #fff;
      padding: 10px 20px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 500;
      opacity: 0;
      transition: opacity 0.3s, transform 0.3s;
      z-index: 2000;
      white-space: nowrap;
    }

    .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
    .toast.success { background: #2d5a0a; }
    .toast.error { background: #b91c1c; }

    @media (max-width: 768px) {
      .edit-fields-row { grid-template-columns: 1fr; }
    }

    /* ── CALENDAR ── */
    .calendar-section {
      background: var(--bg);
      border: 0.5px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0,0,0,0.02);
      margin-bottom: 2rem;
    }

    .calendar-header-bar {
      padding: 1.25rem 1.5rem;
      border-bottom: 0.5px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    .calendar-header-bar h2 {
      font-size: 16px;
      font-weight: 600;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .calendar-nav {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .calendar-nav-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border: 0.5px solid var(--border);
      background: transparent;
      border-radius: 6px;
      cursor: pointer;
      color: var(--text-secondary);
      font-size: 14px;
      transition: all 0.2s;
    }

    .calendar-nav-btn:hover {
      border-color: var(--pink);
      color: var(--pink);
      background: var(--pink-light);
    }

    .calendar-month-label {
      font-family: 'Cormorant Garamond', serif;
      font-size: 20px;
      font-weight: 400;
      font-style: italic;
      color: var(--text-primary);
      min-width: 180px;
      text-align: center;
    }

    .calendar-body {
      padding: 1.5rem;
    }

    .calendar-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 4px;
    }

    .cal-day-name {
      text-align: center;
      font-size: 11px;
      font-weight: 600;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 6px 0 10px;
    }

    .cal-day {
      aspect-ratio: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      cursor: pointer;
      position: relative;
      transition: all 0.15s;
      border: 0.5px solid transparent;
      padding: 4px 2px;
      min-height: 44px;
    }

    .cal-day:hover:not(.cal-empty) {
      background: var(--pink-light);
      border-color: rgba(212, 83, 126, 0.2);
    }

    .cal-day.cal-empty {
      cursor: default;
      pointer-events: none;
    }

    .cal-day.cal-today .cal-num {
      background: var(--pink);
      color: #fff;
      border-radius: 50%;
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
    }

    .cal-day.has-booking {
      background: rgba(212, 83, 126, 0.06);
      border-color: rgba(212, 83, 126, 0.15);
    }

    .cal-day.has-booking:hover {
      background: var(--pink-light);
    }

    .cal-num {
      font-size: 13px;
      font-weight: 500;
      color: var(--text-primary);
      line-height: 1;
    }

    .cal-day.cal-other-month .cal-num {
      color: var(--border);
    }

    .cal-dots {
      display: flex;
      gap: 2px;
      margin-top: 3px;
      flex-wrap: wrap;
      justify-content: center;
      max-width: 100%;
    }

    .cal-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .cal-dot.pending { background: #f59e0b; }
    .cal-dot.confirmed { background: #2d5a0a; }

    .cal-count {
      font-size: 9px;
      font-weight: 600;
      color: var(--pink);
      margin-top: 1px;
      line-height: 1;
    }

    /* Calendar legend */
    .calendar-legend {
      display: flex;
      gap: 1.5rem;
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 0.5px solid var(--border);
      flex-wrap: wrap;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: var(--text-secondary);
    }

    .legend-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    /* Calendar popover */
    .cal-popover {
      display: none;
      position: fixed;
      background: var(--bg);
      border: 0.5px solid var(--border);
      border-radius: 10px;
      padding: 12px 14px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.12);
      z-index: 500;
      min-width: 220px;
      max-width: 280px;
      pointer-events: none;
    }

    .cal-popover.show { display: block; }

    .cal-popover-date {
      font-size: 11px;
      font-weight: 600;
      color: var(--pink);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 8px;
    }

    .cal-popover-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 5px 0;
      border-bottom: 0.5px solid var(--border);
      font-size: 12px;
    }

    .cal-popover-item:last-child { border-bottom: none; }

    .cal-popover-name { font-weight: 500; color: var(--text-primary); }
    .cal-popover-status { }

    @media (max-width: 600px) {
      .cal-day { min-height: 36px; }
      .cal-num { font-size: 11px; }
      .cal-dot { width: 4px; height: 4px; }
      .calendar-month-label { font-size: 16px; min-width: 140px; }
    }

    .loading-spinner {
      display: none;
      text-align: center;
      padding: 3rem 2rem;
    }

    .loading-spinner i { font-size: 36px; color: var(--pink); animation: spin 1s linear infinite; }

    @media (max-width: 768px) {
      .header-content { flex-direction: column; align-items: flex-start; gap: 1rem; }
      .header-controls { width: 100%; flex-direction: column; }
      .filter-group { width: 100%; }
      .filter-group select { width: 100%; }
      .btn-refresh { width: 100%; justify-content: center; }
      .stats-grid { grid-template-columns: 1fr; }
      th, td { padding: 10px 12px; font-size: 12px; }
      .btn-detail { padding: 5px 8px; font-size: 10px; }
      table { font-size: 12px; }
    }
  </style>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
</head>
<body>

<div class="dashboard-header">
  <div class="header-content">
    <div class="header-title">
      <h1>Dashboard Booking</h1>
      <span>MUA</span>
    </div>
    <div class="header-controls">
      <div class="filter-group">
        <label for="filterMonth">Bulan:</label>
        <select id="filterMonth" onchange="filterBookings()">
          <option value="">Semua Bulan</option>
        </select>
      </div>
      <div class="filter-group">
        <label for="filterStatus">Status:</label>
        <select id="filterStatus" onchange="filterBookings()">
          <option value="">Semua Status</option>
          <option value="pending">Pending</option>
          <option value="confirmed">Confirmed</option>
        </select>
      </div>
      <button class="btn-refresh" id="refreshBtn" onclick="loadBookings()">
        <i class="ti ti-refresh" style="font-size:14px;"></i>
        <span>Refresh</span>
      </button>
    </div>
  </div>
</div>

<div class="dashboard-main">

  <div class="stats-grid" id="statsGrid">
    <div class="stat-card">
      <div class="stat-card-content">
        <h3>Total Booking</h3>
        <div class="stat-card-value" id="totalBookings">0</div>
      </div>
      <i class="ti ti-calendar stat-card-icon"></i>
    </div>

    <!-- Total Pemasukan dengan breakdown -->
    <div class="stat-card" style="flex-direction:column; align-items:stretch; gap:0;">
      <div style="display:flex; justify-content:space-between; align-items:flex-start;">
        <div class="stat-card-content">
          <h3>Total Pemasukan</h3>
          <div class="stat-card-value" id="totalRevenue" style="font-size:16px;">Rp 0</div>
        </div>
        <i class="ti ti-cash stat-card-icon"></i>
      </div>
      <div class="stat-breakdown">
        <div class="stat-breakdown-row">
          <span class="stat-breakdown-label dp">DP Diterima</span>
          <span class="stat-breakdown-value dp" id="totalDpDiterima">Rp 0</span>
        </div>
        <div class="stat-breakdown-row">
          <span class="stat-breakdown-label lunas">Pelunasan (Lunas)</span>
          <span class="stat-breakdown-value lunas" id="totalPelunasan">Rp 0</span>
        </div>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-card-content">
        <h3>Total Orang</h3>
        <div class="stat-card-value" id="totalOrang">0</div>
      </div>
      <i class="ti ti-users stat-card-icon"></i>
    </div>
    <div class="stat-card">
      <div class="stat-card-content">
        <h3>Menunggu Pelunasan</h3>
        <div class="stat-card-value" id="pendingDP" style="font-size:16px;">Rp 0</div>
      </div>
      <i class="ti ti-clock stat-card-icon"></i>
    </div>
  </div>

  <!-- Kalender Ketersediaan -->
  <div class="calendar-section">
    <div class="calendar-header-bar">
      <h2><i class="ti ti-calendar-event" style="color:var(--pink);font-size:16px;"></i> Kalender Ketersediaan</h2>
      <div class="calendar-nav">
        <button class="calendar-nav-btn" id="calPrev" onclick="calChangeMonth(-1)">
          <i class="ti ti-chevron-left"></i>
        </button>
        <span class="calendar-month-label" id="calMonthLabel"></span>
        <button class="calendar-nav-btn" id="calNext" onclick="calChangeMonth(1)">
          <i class="ti ti-chevron-right"></i>
        </button>
      </div>
    </div>
    <div class="calendar-body">
      <div class="calendar-grid" id="calGrid"></div>
      <div class="calendar-legend">
        <div class="legend-item">
          <span class="legend-dot" style="background:var(--pink);"></span>
          Hari ini
        </div>
        <div class="legend-item">
          <span class="legend-dot" style="background:#f59e0b;"></span>
          Pending
        </div>
        <div class="legend-item">
          <span class="legend-dot" style="background:#2d5a0a;"></span>
          Confirmed
        </div>
        <div class="legend-item">
          <span class="legend-dot" style="background:rgba(212,83,126,0.15); border:1px solid rgba(212,83,126,0.3); border-radius:50%;"></span>
          Ada Booking
        </div>
      </div>
    </div>
  </div>

  <!-- Popover kalender -->
  <div class="cal-popover" id="calPopover"></div>

  <div class="bookings-section">
    <div class="bookings-header">
      <h2>Daftar Booking</h2>
      <span class="bookings-count" id="bookingsCount">0 booking</span>
    </div>
    <div class="loading-spinner" id="loadingSpinner">
      <i class="ti ti-loader-2"></i>
    </div>
    <div class="bookings-table" id="bookingsContainer">
      <div class="empty-state">
        <i class="ti ti-inbox"></i>
        <p>Belum ada data booking</p>
      </div>
    </div>
  </div>

</div>

<!-- Modal Detail -->
<div class="modal-overlay" id="modalOverlay" onclick="closeModal()">
  <div class="modal-content" onclick="event.stopPropagation()">
    <div class="modal-header">
      <h3>Detail Booking</h3>
      <button class="btn-close" onclick="closeModal()">
        <i class="ti ti-x"></i>
      </button>
    </div>
    <div class="modal-body" id="modalBody">
      <!-- Dynamic content -->
    </div>
    <div class="modal-footer">
      <button class="btn-invoice" id="btnExportInvoice" onclick="exportInvoicePDF()">
        <i class="ti ti-file-invoice" style="font-size:13px;"></i> Export Invoice
      </button>
      <button class="btn-edit" id="btnOpenEdit" onclick="openEditModal()">
        <i class="ti ti-pencil" style="font-size:13px;"></i> Edit Data
      </button>
    </div>
  </div>
</div>

<!-- Modal Edit -->
<div class="edit-modal-overlay" id="editModalOverlay">
  <div class="edit-modal-content" onclick="event.stopPropagation()">
    <div class="edit-modal-header">
      <h3><i class="ti ti-pencil" style="color:var(--pink);font-size:16px;"></i> Edit Booking</h3>
      <button class="btn-close" onclick="closeEditModal()"><i class="ti ti-x"></i></button>
    </div>
    <div class="edit-modal-body" id="editModalBody">
      <!-- Form dinamis -->
    </div>
    <div class="edit-modal-footer">
      <button class="btn-cancel-edit" onclick="closeEditModal()">Batal</button>
      <button class="btn-save-edit" id="btnSaveEdit" onclick="saveEdit()">
        <i class="ti ti-device-floppy" style="font-size:13px;"></i>
        <span id="btnSaveText">Simpan</span>
      </button>
    </div>
  </div>
</div>

<!-- Toast -->
<div class="toast" id="toast"></div>

<script>
  const APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbzW4Rs9Uc7psMTYJgKSRXnE_lWb8rKtJ1IxV4z_-D9R5tiZ4OoAYDAsIRxyd1hOc7NSAQ/exec";

  let allBookings = [];
  let filteredBookings = [];
  let currentBooking = null; // booking yang sedang dibuka di modal

  /* ── Format Helpers ── */
  function fmtRp(n) {
    if (n === 0 || !n) return 'Rp 0';
    return 'Rp ' + parseInt(n).toLocaleString('id-ID');
  }

  function parseRp(str) {
    if (str === null || str === undefined || str === '') return 0;
    if (typeof str === 'number') return Math.round(str);
    const cleaned = String(str).replace(/[^0-9]/g, '');
    return parseInt(cleaned, 10) || 0;
  }

  function parseDate(val) {
    if (val === null || val === undefined || val === '') return null;
    if (typeof val === 'number') {
      const ms = (val - 25569) * 86400 * 1000;
      const d = new Date(ms);
      return isNaN(d) ? null : d;
    }
    const s = String(val).trim();
    if (!s) return null;
    if (/^\d{4}-\d{2}-\d{2}$/.test(s)) return new Date(s + 'T00:00:00');
    if (/^\d{2}\/\d{2}\/\d{4}$/.test(s)) {
      const parts = s.split('/');
      return new Date(parts[2] + '-' + parts[1] + '-' + parts[0] + 'T00:00:00');
    }
    const d = new Date(s);
    return isNaN(d) ? null : d;
  }

  function fmtDate(dateStr) {
    const date = parseDate(dateStr);
    if (!date) return '-';
    return date.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
  }

  function fmtDateTime(dateStr) {
    const date = parseDate(dateStr);
    if (!date) return '-';
    return date.toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' });
  }

  function fmtTime(val) {
    if (val === null || val === undefined || val === '') return '-';
    // Angka serial Sheets: fraksi hari (misal 0.583333 = 14:00)
    if (typeof val === 'number') {
      // Jika angka besar (>= 1), mungkin serial date+time — ambil bagian fraksinya
      const frac = val % 1;
      const totalMinutes = Math.round(frac * 24 * 60);
      const h = Math.floor(totalMinutes / 60);
      const m = totalMinutes % 60;
      // Konversi ke WIB (GMT+7) — Sheets menyimpan waktu di UTC
      const wibH = (h + 7) % 24;
      return String(wibH).padStart(2, '0') + ':' + String(m).padStart(2, '0');
    }
    const s = String(val).trim();
    // Sudah format HH:MM atau HH:MM:SS — langsung tampilkan
    if (/^\d{1,2}:\d{2}/.test(s)) return s.slice(0, 5);
    // ISO string dengan T (misal dari Date.toISOString)
    if (s.includes('T')) {
      const timePart = s.split('T')[1] || '';
      if (timePart) {
        const [hh, mm] = timePart.split(':');
        const wibH = (parseInt(hh, 10) + 7) % 24;
        return String(wibH).padStart(2, '0') + ':' + mm.slice(0, 2);
      }
    }
    return s;
  }

  /* ── Normalize Booking Fields ── */
  // Memetakan semua kemungkinan nama kolom dari Google Sheets ke key standar yang dipakai di JS
  function normalizeBooking(raw) {
    // Buat lookup case-insensitive dari semua key yang ada
    const lookup = {};
    Object.keys(raw).forEach(k => {
      lookup[k.toLowerCase().replace(/\s+/g, '_')] = raw[k];
      // juga simpan key aslinya
      lookup[k.toLowerCase()] = raw[k];
    });

    const pick = (...candidates) => {
      for (const c of candidates) {
        const v = lookup[c.toLowerCase().replace(/\s+/g, '_')] ?? lookup[c.toLowerCase()];
        if (v !== undefined && v !== null && v !== '') return v;
      }
      return '';
    };

    return {
      timestamp:       pick('timestamp'),
      nama:            pick('nama', 'name', 'Nama'),
      wa:              pick('wa', 'whatsapp', 'no_wa', 'nomor_wa', 'phone', 'WA'),
      email:           pick('email', 'Email'),
      lokasi:          pick('lokasi', 'location', 'Lokasi'),
      tanggal:         pick('tanggal', 'date', 'Tanggal', 'tgl'),
      jam_selesai:     pick('jam_selesai', 'jam selesai', 'Jam Selesai', 'jam'),
      paket:           pick('paket', 'package', 'Paket', 'pak'),
      addon:           pick('addon', 'add_on', 'add on', 'Add On', 'tambahan', 'pilihan add on & jumlah', 'add on & jumlah'),
      jumlah_orang:    pick('jumlah_orang', 'jumlah orang', 'Jumlah Orang', 'orang', 'pax'),
      subtotal:        pick('subtotal', 'total', 'Total', 'harga', 'Subtotal'),
      dp:              pick('dp', 'down_payment', 'DP', 'uang_muka'),
      transport_biaya: pick('transport_biaya', 'transport biaya', 'Transport Biaya', 'transport', 'biaya_transport'),
      bukti:           pick('bukti', 'bukti_transfer', 'Bukti Transfer', 'bukti transfer'),
      status:          pick('status', 'Status') || 'pending',
      // simpan semua field asli juga, untuk jaga-jaga
      _raw: raw,
    };
  }

  /* ── Load Bookings ── */
  async function loadBookings() {
    const btn = document.getElementById('refreshBtn');
    const spinner = document.getElementById('loadingSpinner');
    const container = document.getElementById('bookingsContainer');

    btn.classList.add('loading');
    btn.disabled = true;
    spinner.style.display = 'block';

    try {
      const response = await fetch(APPS_SCRIPT_URL + '?action=getBookings');
      const data = await response.json();

      if (data.success && data.bookings) {
        // Simpan rowIndex (nomor baris di sheet, mulai dari 2) sebagai identifier paling reliable
        allBookings = data.bookings.map((b, i) => {
          const norm = normalizeBooking(b);
          norm._rowIndex = (data.startRow || 2) + i; // Apps Script kirim startRow, default baris ke-2
          return norm;
        });
        console.log('[Dashboard] Raw sample:', data.bookings[0]);
        console.log('[Dashboard] Normalized sample:', allBookings[0]);
        populateMonthFilter();
        filterBookings();
        renderCalendar();
      } else {
        container.innerHTML = '<div class="empty-state"><i class="ti ti-alert-circle"></i><p>Gagal memuat data</p></div>';
      }
    } catch (err) {
      console.error('Error loading bookings:', err);
      container.innerHTML = '<div class="empty-state"><i class="ti ti-alert-circle"></i><p>Error: ' + err.message + '</p></div>';
    } finally {
      btn.classList.remove('loading');
      btn.disabled = false;
      spinner.style.display = 'none';
    }
  }

  /* ── Populate Month Filter ── */
  function populateMonthFilter() {
    const filterMonth = document.getElementById('filterMonth');
    const months = new Set();

    allBookings.forEach(b => {
      if (b.tanggal || b.tanggal === 0) {
        const d = parseDate(b.tanggal);
        if (d) {
          const year = d.getFullYear();
          const month = String(d.getMonth() + 1).padStart(2, '0');
          months.add(year + '-' + month);
        }
      }
    });

    const sortedMonths = Array.from(months).sort().reverse();
    const currentOptions = filterMonth.innerHTML;

    sortedMonths.forEach(monthStr => {
      if (!currentOptions.includes(monthStr)) {
        const [year, month] = monthStr.split('-');
        const date = new Date(year, parseInt(month) - 1);
        const label = date.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
        const option = document.createElement('option');
        option.value = monthStr;
        option.textContent = label;
        filterMonth.appendChild(option);
      }
    });
  }

  /* ── Filter Bookings ── */
  function filterBookings() {
    const monthFilter = document.getElementById('filterMonth').value;
    const statusFilter = document.getElementById('filterStatus').value;

    filteredBookings = allBookings.filter(b => {
      let match = true;

      if (monthFilter) {
        const [year, month] = monthFilter.split('-');
        const bd = parseDate(b.tanggal);
        const bYear = bd ? String(bd.getFullYear()) : '';
        const bMonth = bd ? String(bd.getMonth() + 1).padStart(2, '0') : '';
        match = match && bd && (bYear + '-' + bMonth) === (year + '-' + month);
      }

      if (statusFilter) {
        match = match && (b.status || 'pending') === statusFilter;
      }

      return match;
    });

    // Urutkan berdasarkan tanggal terdekat dari sekarang:
    // booking mendatang (>= hari ini) diurutkan ascending (paling dekat dulu),
    // lalu booking yang sudah lewat diurutkan descending (paling baru dulu).
    const now = new Date();
    now.setHours(0, 0, 0, 0);

    const upcoming = [];
    const past = [];

    filteredBookings.forEach(b => {
      const d = parseDate(b.tanggal);
      if (d && d >= now) {
        upcoming.push(b);
      } else {
        past.push(b);
      }
    });

    upcoming.sort((a, b) => {
      const da = parseDate(a.tanggal) || new Date(0);
      const db = parseDate(b.tanggal) || new Date(0);
      return da - db;
    });

    past.sort((a, b) => {
      const da = parseDate(a.tanggal) || new Date(0);
      const db = parseDate(b.tanggal) || new Date(0);
      return db - da;
    });

    filteredBookings = [...upcoming, ...past];

    renderTable();
    updateStats();
  }

  /* ── Render Table ── */
  function renderTable() {
    const container = document.getElementById('bookingsContainer');
    const count = document.getElementById('bookingsCount');

    count.textContent = filteredBookings.length + ' booking';

    if (filteredBookings.length === 0) {
      container.innerHTML = '<div class="empty-state"><i class="ti ti-inbox"></i><p>Tidak ada booking sesuai filter</p></div>';
      return;
    }

    let html = `<table>
      <thead>
        <tr>
          <th>Nama</th>
          <th>Tanggal</th>
          <th>Paket</th>
          <th>Total</th>
          <th>DP</th>
          <th>Sisa</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
    `;

    filteredBookings.forEach(booking => {
      const status = booking.status || 'pending';
      const statusClass = status === 'confirmed' ? 'status-confirmed' : 'status-pending';
      const statusText = status === 'confirmed' ? 'Confirmed' : 'Pending';

      const total = parseRp(booking.subtotal);
      const dp = parseRp(booking.dp);
      const sisa = total - dp;

      html += `<tr onclick="openModal('${encodeURIComponent(JSON.stringify(booking))}')">
        <td class="name-col">${booking.nama || '-'}</td>
        <td class="date-col">${fmtDate(booking.tanggal)}</td>
        <td class="paket-col">${booking.paket ? booking.paket.split('|')[0].trim() : '-'}</td>
        <td class="price-col">${fmtRp(total)}</td>
        <td>${fmtRp(dp)}</td>
        <td class="price-col">${fmtRp(sisa)}</td>
        <td><span class="status-badge ${statusClass}">${statusText}</span></td>
        <td><button class="btn-detail" onclick="event.stopPropagation(); openModal('${encodeURIComponent(JSON.stringify(booking))}')">
          <i class="ti ti-eye" style="font-size:12px;"></i> Detail
        </button></td>
      </tr>`;
    });

    html += `</tbody></table>`;
    container.innerHTML = html;
  }

  /* ── Update Stats ── */
  function updateStats() {
    const totalBookings = filteredBookings.length;
    let totalOrang      = 0;
    let totalDpDiterima = 0;  // semua DP — sudah pasti diterima saat booking masuk
    let totalPelunasan  = 0;  // sisa bayar — hanya dihitung jika status = confirmed/lunas
    let menungguPelunasan = 0; // sisa yang belum lunas

    filteredBookings.forEach(b => {
      const subtotal = parseRp(b.subtotal);
      const dp       = parseRp(b.dp);
      const sisa     = Math.max(0, subtotal - dp);
      const status   = (b.status || '').toLowerCase().trim();
      const sudahLunas = status === 'confirmed' || status === 'lunas';

      totalOrang        += parseInt(b.jumlah_orang) || 0;
      totalDpDiterima   += dp;                          // DP selalu diterima
      totalPelunasan    += sudahLunas ? sisa : 0;       // sisa baru masuk kalau lunas
      menungguPelunasan += sudahLunas ? 0 : sisa;       // sisa yang masih outstanding
    });

    const totalRevenue = totalDpDiterima + totalPelunasan;

    document.getElementById('totalBookings').textContent     = totalBookings;
    document.getElementById('totalRevenue').textContent      = fmtRp(totalRevenue);
    document.getElementById('totalDpDiterima').textContent   = fmtRp(totalDpDiterima);
    document.getElementById('totalPelunasan').textContent    = fmtRp(totalPelunasan);
    document.getElementById('totalOrang').textContent        = totalOrang;
    document.getElementById('pendingDP').textContent         = fmtRp(menungguPelunasan);
  }

  /* ── Render Layanan / Add On list dari string Google Sheets ──
     Format yang mungkin masuk dari Sheets:
     1. "Hairdo – Rp 150.000 x1 | Softlens – Rp 50.000 x2"   (dengan harga & pemisah |)
     2. "Hairdo x1, Softlens x1"                               (tanpa harga, pemisah ,)
     3. "Wisuda Hijab – Rp 600.000 x1 orang | Pendamping – Rp 350.000 x2 orang"
  ── */
  function renderLayananList(raw, isAddon = false) {
    if (!raw || raw.toString().trim() === '') return isAddon ? 'Tidak ada' : '-';

    const str = raw.toString().trim();

    // Pisahkan per item — coba pemisah | dulu, lalu ,
    let items;
    if (str.includes('|')) {
      items = str.split('|').map(s => s.trim()).filter(Boolean);
    } else {
      items = str.split(',').map(s => s.trim()).filter(Boolean);
    }

    if (items.length === 0) return isAddon ? 'Tidak ada' : str;
    if (items.length === 1) return formatSatuItem(items[0]);

    // Lebih dari 1 item → tampilkan sebagai list
    const listItems = items.map(item => `<li style="margin-bottom:2px;">${formatSatuItem(item)}</li>`).join('');
    return `<ul style="margin:0;padding-left:16px;list-style:disc;">${listItems}</ul>`;
  }

  function formatSatuItem(item) {
    // Cek apakah sudah ada harga (mengandung "Rp")
    if (item.includes('Rp') || item.includes('rp')) {
      // Sudah ada harga — tampilkan apa adanya tapi pastikan format Rp rapi
      return item.replace(/Rp\s*([\d.,]+)/g, (_, angka) => {
        const num = parseInt(angka.replace(/[.,]/g, ''));
        return 'Rp ' + num.toLocaleString('id-ID');
      });
    }
    // Tidak ada harga — tandai dengan label abu-abu
    return item + ' <span style="font-size:11px;color:var(--text-secondary);font-style:italic;">(harga tidak tercatat)</span>';
  }

  /* ── Modal ── */
  function openModal(encodedBooking) {
    const booking = JSON.parse(decodeURIComponent(encodedBooking));
    currentBooking = booking; // simpan untuk tombol edit
    const modalBody = document.getElementById('modalBody');

    const total = parseRp(booking.subtotal);
    const dp = parseRp(booking.dp);
    const sisa = total - dp;

    const status = booking.status || 'pending';
    const statusClass = status === 'confirmed' ? 'status-confirmed' : 'status-pending';
    const statusText = status === 'confirmed' ? 'Confirmed' : 'Pending';

    let html = `
      <div class="detail-section">
        <div class="detail-section-title">
          <i class="ti ti-user"></i> Informasi Klien
        </div>
        <div class="detail-row">
          <span class="detail-label">Nama</span>
          <span class="detail-value">${booking.nama || '-'}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">WhatsApp</span>
          <span class="detail-value"><a href="https://wa.me/${booking.wa}" target="_blank" style="color:var(--pink); text-decoration:none;">${booking.wa || '-'}</a></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Email</span>
          <span class="detail-value">${booking.email || '-'}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Lokasi</span>
          <span class="detail-value">${booking.lokasi || '-'}</span>
        </div>
      </div>

      <div class="detail-section">
        <div class="detail-section-title">
          <i class="ti ti-calendar"></i> Jadwal
        </div>
        <div class="detail-row">
          <span class="detail-label">Tanggal</span>
          <span class="detail-value">${fmtDateTime(booking.tanggal)}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Jam Selesai</span>
          <span class="detail-value">${fmtTime(booking.jam_selesai)}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Total Orang</span>
          <span class="detail-value">${booking.jumlah_orang || '-'} orang</span>
        </div>
      </div>

      <div class="detail-section">
        <div class="detail-section-title">
          <i class="ti ti-shopping-cart"></i> Layanan
        </div>
        <div class="detail-row">
          <span class="detail-label">Paket</span>
          <span class="detail-value">${renderLayananList(booking.paket)}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Add On</span>
          <span class="detail-value">${renderLayananList(booking.addon, true)}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Transport</span>
          <span class="detail-value">${booking.transport_biaya ? fmtRp(parseRp(booking.transport_biaya)) || booking.transport_biaya : '-'}</span>
        </div>
      </div>

      <div class="detail-section">
        <div class="detail-section-title">
          <i class="ti ti-cash"></i> Pembayaran
        </div>
        <div class="detail-row">
          <span class="detail-label">Subtotal</span>
          <span class="detail-value highlight">${fmtRp(total)}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">DP</span>
          <span class="detail-value">${fmtRp(dp)}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Sisa Bayar</span>
          <span class="detail-value highlight">${fmtRp(sisa)}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Status</span>
          <span class="detail-value"><span class="status-badge ${statusClass}">${statusText}</span></span>
        </div>
      </div>
    `;

    if (booking.bukti) {
      html += `
        <div class="detail-section">
          <div class="detail-section-title">
            <i class="ti ti-file"></i> Bukti Transfer
          </div>
          <div class="detail-row">
            <span class="detail-label">File</span>
            <span class="detail-value">${booking.bukti}</span>
          </div>
        </div>
      `;
    }

    modalBody.innerHTML = html;
    document.getElementById('modalOverlay').classList.add('show');
  }

  function closeModal() {
    document.getElementById('modalOverlay').classList.remove('show');
  }

  /* ── Edit Modal ── */
  function dateToInputValue(val) {
    const d = parseDate(val);
    if (!d) return '';
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  }

  function openEditModal() {
    if (!currentBooking) return;
    const b = currentBooking;

    const editBody = document.getElementById('editModalBody');
    editBody.innerHTML = `
      <div class="edit-section-title"><i class="ti ti-user"></i> Informasi Klien</div>
      <div class="edit-field">
        <label>Nama</label>
        <input type="text" id="ef_nama" value="${b.nama || ''}" placeholder="Nama klien">
      </div>
      <div class="edit-fields-row">
        <div class="edit-field">
          <label>WhatsApp</label>
          <input type="text" id="ef_wa" value="${b.wa || ''}" placeholder="628xxxxxxx">
        </div>
        <div class="edit-field">
          <label>Email</label>
          <input type="email" id="ef_email" value="${b.email || ''}" placeholder="email@example.com">
        </div>
      </div>
      <div class="edit-field">
        <label>Lokasi</label>
        <input type="text" id="ef_lokasi" value="${b.lokasi || ''}" placeholder="Alamat / lokasi make up">
      </div>

      <div class="edit-section-title"><i class="ti ti-calendar"></i> Jadwal</div>
      <div class="edit-fields-row">
        <div class="edit-field">
          <label>Tanggal Make Up</label>
          <input type="date" id="ef_tanggal" value="${dateToInputValue(b.tanggal)}">
        </div>
        <div class="edit-field">
          <label>Jam Selesai</label>
          <input type="time" id="ef_jam_selesai" value="${fmtTime(b.jam_selesai) !== '-' ? fmtTime(b.jam_selesai) : ''}">
        </div>
      </div>
      <div class="edit-field">
        <label>Jumlah Orang</label>
        <input type="number" id="ef_jumlah_orang" value="${b.jumlah_orang || ''}" min="1" placeholder="1">
      </div>

      <div class="edit-section-title"><i class="ti ti-shopping-cart"></i> Layanan</div>
      <div class="edit-field">
        <label>Paket</label>
        <input type="text" id="ef_paket" value="${b.paket || ''}" placeholder="Nama paket">
      </div>
      <div class="edit-field">
        <label>Add On</label>
        <input type="text" id="ef_addon" value="${b.addon || ''}" placeholder="Tambahan layanan">
      </div>
      <div class="edit-field">
        <label>Transport / Biaya Transport</label>
        <input type="text" id="ef_transport" value="${b.transport_biaya || ''}" placeholder="Misal: Rp 50.000">
      </div>

      <div class="edit-section-title"><i class="ti ti-cash"></i> Pembayaran</div>
      <div class="edit-fields-row">
        <div class="edit-field">
          <label>Subtotal (Rp)</label>
          <input type="number" id="ef_subtotal" value="${parseRp(b.subtotal) || ''}" placeholder="0">
        </div>
        <div class="edit-field">
          <label>DP (Rp)</label>
          <input type="number" id="ef_dp" value="${parseRp(b.dp) || ''}" placeholder="0">
        </div>
      </div>
      <div class="edit-field">
        <label>Status</label>
        <select id="ef_status">
          <option value="pending" ${(b.status || 'pending') === 'pending' ? 'selected' : ''}>Pending</option>
          <option value="confirmed" ${b.status === 'confirmed' ? 'selected' : ''}>Confirmed</option>
        </select>
      </div>
    `;

    document.getElementById('editModalOverlay').classList.add('show');
  }

  function closeEditModal() {
    document.getElementById('editModalOverlay').classList.remove('show');
  }

  /* ── Save Edit → Apps Script via GET (kompatibel CORS) ── */
  async function saveEdit() {
    if (!currentBooking) return;

    const btn = document.getElementById('btnSaveEdit');
    const btnText = document.getElementById('btnSaveText');
    btn.disabled = true;
    btnText.textContent = 'Menyimpan...';

    const updated = {
      // rowIndex = nomor baris di sheet (paling reliable, tidak tergantung format Timestamp)
      rowIndex:        currentBooking._rowIndex || '',
      // timestamp sebagai fallback jika rowIndex tidak tersedia
      timestamp:       currentBooking.timestamp || '',
      nama:            document.getElementById('ef_nama').value.trim(),
      wa:              document.getElementById('ef_wa').value.trim(),
      email:           document.getElementById('ef_email').value.trim(),
      lokasi:          document.getElementById('ef_lokasi').value.trim(),
      tanggal:         document.getElementById('ef_tanggal').value,
      jam_selesai:     document.getElementById('ef_jam_selesai').value,
      jumlah_orang:    document.getElementById('ef_jumlah_orang').value,
      paket:           document.getElementById('ef_paket').value.trim(),
      addon:           document.getElementById('ef_addon').value.trim(),
      transport_biaya: document.getElementById('ef_transport').value.trim(),
      subtotal:        document.getElementById('ef_subtotal').value,
      dp:              document.getElementById('ef_dp').value,
      status:          document.getElementById('ef_status').value,
    };

    console.log('[Edit] Sending update:', updated);

    const params = new URLSearchParams({ action: 'updateBooking' });
    Object.entries(updated).forEach(([k, v]) => params.append(k, v ?? ''));

    try {
      const response = await fetch(APPS_SCRIPT_URL + '?' + params.toString());
      const result = await response.json();
      console.log('[Edit] Apps Script response:', result);

      if (result.success) {
        // Update data lokal agar tampilan langsung berubah tanpa reload
        const idx = allBookings.findIndex(b => b._rowIndex === currentBooking._rowIndex);
        if (idx !== -1) {
          allBookings[idx] = { ...allBookings[idx], ...updated };
          currentBooking = allBookings[idx];
        }

        closeEditModal();
        filterBookings();
        openModal(encodeURIComponent(JSON.stringify(currentBooking)));
        showToast('✓ Data berhasil disimpan!', 'success');
      } else {
        showToast('Gagal: ' + (result.message || 'Error tidak diketahui'), 'error');
      }
    } catch (err) {
      console.error('Save error:', err);
      showToast('Koneksi gagal. Pastikan Apps Script sudah di-deploy ulang.', 'error');
    } finally {
      btn.disabled = false;
      btnText.textContent = 'Simpan';
    }
  }

  /* ── Toast ── */
  function showToast(msg, type = '') {
    const toast = document.getElementById('toast');
    toast.textContent = msg;
    toast.className = 'toast' + (type ? ' ' + type : '');
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 3500);
  }

  document.getElementById('editModalOverlay').addEventListener('click', function(e) {
    if (e.target === this) closeEditModal();
  });

  document.getElementById('modalOverlay').addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  /* ══════════════════════════════════════════════
     CALENDAR
  ══════════════════════════════════════════════ */
  let calYear = new Date().getFullYear();
  let calMonth = new Date().getMonth(); // 0-indexed

  const CAL_DAYS_ID = ['Min', 'Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab'];
  const MONTH_NAMES = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];

  function calChangeMonth(delta) {
    calMonth += delta;
    if (calMonth > 11) { calMonth = 0; calYear++; }
    if (calMonth < 0)  { calMonth = 11; calYear--; }
    renderCalendar();
  }

  function renderCalendar() {
    const label = document.getElementById('calMonthLabel');
    const grid  = document.getElementById('calGrid');
    if (!label || !grid) return;

    label.textContent = MONTH_NAMES[calMonth] + ' ' + calYear;

    const today = new Date();
    today.setHours(0, 0, 0, 0);

    // Build booking map: key = "YYYY-MM-DD" → array of bookings
    const bookingMap = {};
    allBookings.forEach(b => {
      const d = parseDate(b.tanggal);
      if (!d) return;
      const key = d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
      if (!bookingMap[key]) bookingMap[key] = [];
      bookingMap[key].push(b);
    });

    const firstDay = new Date(calYear, calMonth, 1).getDay(); // 0=Sun
    const daysInMonth = new Date(calYear, calMonth + 1, 0).getDate();
    const daysInPrev = new Date(calYear, calMonth, 0).getDate();

    let html = '';

    // Day headers
    CAL_DAYS_ID.forEach(d => {
      html += `<div class="cal-day-name">${d}</div>`;
    });

    // Prev month padding
    for (let i = 0; i < firstDay; i++) {
      const dayNum = daysInPrev - firstDay + 1 + i;
      html += `<div class="cal-day cal-empty cal-other-month"><span class="cal-num">${dayNum}</span></div>`;
    }

    // Current month days
    for (let day = 1; day <= daysInMonth; day++) {
      const dateKey = calYear + '-' + String(calMonth+1).padStart(2,'0') + '-' + String(day).padStart(2,'0');
      const dayDate = new Date(calYear, calMonth, day);
      dayDate.setHours(0,0,0,0);
      const isToday = dayDate.getTime() === today.getTime();
      const bookings = bookingMap[dateKey] || [];
      const hasBooking = bookings.length > 0;

      const pendingCount   = bookings.filter(b => (b.status||'pending') === 'pending').length;
      const confirmedCount = bookings.filter(b => (b.status||'pending') === 'confirmed').length;

      let dotsHtml = '';
      if (pendingCount > 0)   dotsHtml += `<span class="cal-dot pending"></span>`.repeat(Math.min(pendingCount, 3));
      if (confirmedCount > 0) dotsHtml += `<span class="cal-dot confirmed"></span>`.repeat(Math.min(confirmedCount, 3));

      const classes = [
        'cal-day',
        isToday ? 'cal-today' : '',
        hasBooking ? 'has-booking' : '',
      ].filter(Boolean).join(' ');

      const encodedBookings = hasBooking ? encodeURIComponent(JSON.stringify(bookings.map(b => ({nama: b.nama, status: b.status||'pending'})))) : '';
      const onclickAttr = hasBooking
        ? `onclick="calDayClick(event, '${dateKey}', '${encodedBookings}')"`
        : `onclick="calDayClickEmpty(event, '${dateKey}')"`;

      html += `
        <div class="${classes}" ${onclickAttr} 
             onmouseenter="calShowPopover(event, '${dateKey}', '${encodedBookings}')"
             onmouseleave="calHidePopover()">
          <span class="cal-num">${day}</span>
          ${hasBooking ? `<div class="cal-dots">${dotsHtml}</div>` : ''}
          ${bookings.length > 3 ? `<span class="cal-count">+${bookings.length}</span>` : ''}
        </div>`;
    }

    // Next month padding to complete grid
    const totalCells = firstDay + daysInMonth;
    const remainder = totalCells % 7;
    if (remainder !== 0) {
      const nextPad = 7 - remainder;
      for (let i = 1; i <= nextPad; i++) {
        html += `<div class="cal-day cal-empty cal-other-month"><span class="cal-num">${i}</span></div>`;
      }
    }

    grid.innerHTML = html;
  }

  function calShowPopover(e, dateKey, encodedBookings) {
    if (!encodedBookings) return;
    const popover = document.getElementById('calPopover');
    let bookings = [];
    try { bookings = JSON.parse(decodeURIComponent(encodedBookings)); } catch(err) { return; }

    const [yr, mo, dy] = dateKey.split('-');
    const d = new Date(yr, parseInt(mo)-1, parseInt(dy));
    const dateLabel = d.toLocaleDateString('id-ID', { weekday:'long', day:'2-digit', month:'long', year:'numeric' });

    let itemsHtml = bookings.map(b => `
      <div class="cal-popover-item">
        <span class="cal-popover-name">${b.nama || 'Tanpa Nama'}</span>
        <span class="cal-popover-status">
          <span class="status-badge status-${b.status}">${b.status === 'confirmed' ? 'Confirmed' : 'Pending'}</span>
        </span>
      </div>`).join('');

    popover.innerHTML = `<div class="cal-popover-date">${dateLabel}</div>${itemsHtml}`;

    const rect = e.currentTarget.getBoundingClientRect();
    const pw = 240;
    let left = rect.left + rect.width / 2 - pw / 2;
    let top  = rect.bottom + 8;

    if (left + pw > window.innerWidth - 16) left = window.innerWidth - pw - 16;
    if (left < 8) left = 8;
    if (top + 120 > window.innerHeight) top = rect.top - 120;

    popover.style.left = left + 'px';
    popover.style.top  = top + 'px';
    popover.classList.add('show');
  }

  function calHidePopover() {
    const p = document.getElementById('calPopover');
    if (p) p.classList.remove('show');
  }

  function calDayClick(event, dateKey, encodedBookings) {
    // Filter table to this date
    const [yr, mo] = dateKey.split('-');
    const monthVal = yr + '-' + mo;

    // Set filter bulan
    const filterMonth = document.getElementById('filterMonth');
    filterMonth.value = monthVal;

    // Filter bookings for this specific date
    const allCopy = allBookings.filter(b => {
      const d = parseDate(b.tanggal);
      if (!d) return false;
      const key = d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
      return key === dateKey;
    });

    filteredBookings = allCopy;
    renderTable();

    // Scroll to table
    document.querySelector('.bookings-section').scrollIntoView({ behavior: 'smooth', block: 'start' });
    calHidePopover();
  }

  function calDayClickEmpty(event, dateKey) {
    // No action for empty days
  }

  /* ── Init ── */
  window.addEventListener('DOMContentLoaded', () => {
    renderCalendar();
    loadBookings();
  });

  /* ══════════════════════════════════════════════
     EXPORT INVOICE PDF
  ══════════════════════════════════════════════ */
  function exportInvoicePDF() {
    if (!currentBooking) return;
    const b = currentBooking;
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({ unit: 'mm', format: 'a4' });

    const W = 210, MARGIN = 20, CONTENT_W = 210 - 20 * 2;
    const PINK  = [212, 83, 126];
    const DARK  = [26, 26, 26];
    const GRAY  = [107, 107, 107];
    const LGRAY = [245, 245, 245];
    const WHITE = [255, 255, 255];
    const GREEN = [45, 90, 10];

    let y = 0;

    const rp = (n) => {
      const num = parseRp(n);
      if (!num) return 'Rp 0';
      return 'Rp ' + num.toLocaleString('id-ID');
    };

    const txt = (text, x, yPos, opts = {}) => {
      if (opts.color) doc.setTextColor(...opts.color);
      else doc.setTextColor(...DARK);
      doc.setFontSize(opts.size || 9);
      doc.setFont('helvetica', opts.bold ? 'bold' : 'normal');
      const align = opts.align || 'left';
      doc.text(String(text), x, yPos, { align });
    };

    const hline = (y1, color = [224,224,224], lw = 0.3) => {
      doc.setDrawColor(...color);
      doc.setLineWidth(lw);
      doc.line(MARGIN, y1, W - MARGIN, y1);
    };

    const fillRect = (x, ry, w, h, fill) => {
      doc.setFillColor(...fill);
      doc.setDrawColor(...fill);
      doc.rect(x, ry, w, h, 'F');
    };

    // ── HEADER ──
    y = 18;
    fillRect(0, 0, 6, 32, PINK);
    txt('INVOICE', MARGIN, y, { bold: true, size: 22, color: PINK });
    y += 7;
    txt('Booking Ratu Ayu MUA', MARGIN, y, { size: 9, color: GRAY });

    const invoiceNo = 'INV-' + String(b.timestamp || Date.now()).replace(/\D/g,'').slice(-8);
    const today = new Date().toLocaleDateString('id-ID', { day:'2-digit', month:'long', year:'numeric' });
    txt('No. Invoice', W - MARGIN, y - 7, { align: 'right', size: 8, color: GRAY });
    txt(invoiceNo, W - MARGIN, y - 2, { align: 'right', size: 9, bold: true });
    txt('Tanggal cetak: ' + today, W - MARGIN, y + 4, { align: 'right', size: 8, color: GRAY });

    y = 35;
    hline(y, PINK, 0.6);

    // ── INFORMASI KLIEN ──
    y += 8;
    txt('INFORMASI KLIEN', MARGIN, y, { bold: true, size: 8, color: PINK });
    y += 5;

    const colL = MARGIN, colR = MARGIN + 38;
    const infoRows = [
      ['Nama',      b.nama    || '-'],
      ['WhatsApp',  b.wa      || '-'],
      ['Email',     b.email   || '-'],
      ['Lokasi',    b.lokasi  || '-'],
    ];

    infoRows.forEach(([label, val]) => {
      txt(label, colL, y, { size: 8, color: GRAY });
      const lines = doc.splitTextToSize(String(val), CONTENT_W - 40);
      txt(lines[0], colR, y, { size: 8 });
      if (lines.length > 1) { y += 4; txt(lines[1], colR, y, { size: 8 }); }
      y += 5;
    });

    // ── JADWAL ──
    y += 2; hline(y); y += 6;
    txt('DETAIL JADWAL', MARGIN, y, { bold: true, size: 8, color: PINK });
    y += 5;

    [
      ['Tanggal Make Up', fmtDateTime(b.tanggal)],
      ['Jam Selesai',     fmtTime(b.jam_selesai) !== '-' ? fmtTime(b.jam_selesai) + ' WIB' : '-'],
      ['Total Orang',     (b.jumlah_orang || '-') + ' orang'],
    ].forEach(([label, val]) => {
      txt(label, colL, y, { size: 8, color: GRAY });
      txt(String(val), colR, y, { size: 8 });
      y += 5;
    });

    // ── RINCIAN LAYANAN ──
    y += 2; hline(y); y += 6;
    txt('RINCIAN LAYANAN', MARGIN, y, { bold: true, size: 8, color: PINK });
    y += 5;

    // Header tabel
    fillRect(MARGIN, y - 4.5, CONTENT_W, 7, PINK);
    txt('Kategori',    MARGIN + 3,         y, { bold: true, size: 8, color: WHITE });
    txt('Item',        MARGIN + 35,        y, { bold: true, size: 8, color: WHITE });
    txt('Harga',       W - MARGIN - 3,     y, { bold: true, size: 8, color: WHITE, align: 'right' });
    y += 5;

    const parseItems = (raw) => {
      if (!raw || !raw.toString().trim()) return [];
      const s = raw.toString().trim();
      return (s.includes('|') ? s.split('|') : s.split(',')).map(x => x.trim()).filter(Boolean);
    };

    let rowAlt = false;

    const drawRow = (kategori, items, isAddon) => {
      items.forEach((item, i) => {
        if (rowAlt) fillRect(MARGIN, y - 4, CONTENT_W, 6.5, LGRAY);
        txt(i === 0 ? kategori : '', MARGIN + 3, y, { size: 7.5, color: GRAY, bold: i === 0 });

        const clean = item.replace(/Rp\s*([\d.,]+)/g, (_, n) =>
          'Rp ' + parseInt(n.replace(/[.,]/g,'')).toLocaleString('id-ID'));

        const m = clean.match(/^(.+?)\s*[–\-]\s*(Rp[\s\d.,]+)\s*(x\d+.*)$/i);
        if (m) {
          txt(m[1].trim() + '  ' + m[3].trim(), MARGIN + 35, y, { size: 7.5 });
          txt(m[2].trim(), W - MARGIN - 3, y, { size: 7.5, align: 'right', color: isAddon ? GRAY : DARK });
        } else {
          const wl = doc.splitTextToSize(clean, CONTENT_W - 55);
          txt(wl[0], MARGIN + 35, y, { size: 7.5 });
          txt('—', W - MARGIN - 3, y, { size: 7.5, align: 'right', color: GRAY });
          if (wl.length > 1) { y += 4.5; txt(wl[1], MARGIN + 35, y, { size: 7.5 }); }
        }
        y += 6;
        rowAlt = !rowAlt;
      });
    };

    drawRow('Paket',  parseItems(b.paket), false);
    drawRow('Add On', parseItems(b.addon), true);

    const transport = parseRp(b.transport_biaya);
    if (transport > 0) {
      if (rowAlt) fillRect(MARGIN, y - 4, CONTENT_W, 6.5, LGRAY);
      txt('Transport', MARGIN + 3,  y, { size: 7.5, color: GRAY });
      txt('Biaya Transport', MARGIN + 35, y, { size: 7.5 });
      txt(rp(transport), W - MARGIN - 3, y, { size: 7.5, align: 'right' });
      y += 6;
    }

    // ── PEMBAYARAN ──
    y += 3; hline(y); y += 6;
    txt('RINGKASAN PEMBAYARAN', MARGIN, y, { bold: true, size: 8, color: PINK });
    y += 6;

    const subtotal   = parseRp(b.subtotal);
    const dp         = parseRp(b.dp);
    const sisa       = Math.max(0, subtotal - dp);
    const sudahLunas = (b.status || '').toLowerCase() === 'confirmed';

    const payX = W - MARGIN - 65;
    [
      { label: 'Subtotal',   val: rp(subtotal), bold: false, color: DARK  },
      { label: 'DP Dibayar', val: rp(dp),       bold: false, color: DARK  },
      { label: 'Sisa Bayar', val: rp(sisa),     bold: true,  color: sudahLunas ? GREEN : PINK },
    ].forEach(row => {
      txt(row.label, payX,           y, { size: 8, color: GRAY });
      txt(row.val,   W - MARGIN, y, { size: 8, align: 'right', bold: row.bold, color: row.color });
      y += 5.5;
    });

    y += 1; hline(y, PINK, 0.5); y += 5;

    // Badge status
    const statusText  = sudahLunas ? 'LUNAS' : 'BELUM LUNAS';
    const statusColor = sudahLunas ? GREEN : PINK;
    const statusBg    = sudahLunas ? [230, 245, 218] : [252, 232, 240];
    const bW = 34, bH = 8, bX = W - MARGIN - bW;
    fillRect(bX, y - 5.5, bW, bH, statusBg);
    doc.setDrawColor(...statusColor);
    doc.setLineWidth(0.4);
    doc.rect(bX, y - 5.5, bW, bH, 'S');
    txt(statusText, bX + bW / 2, y - 0.5, { size: 7.5, bold: true, color: statusColor, align: 'center' });

    // ── FOOTER ──
    hline(284, [200,200,200], 0.3);
    txt('Terima kasih atas kepercayaan Anda!', W / 2, 288, { size: 7.5, color: GRAY, align: 'center' });
    txt('Invoice dicetak otomatis dari sistem booking MUA.', W / 2, 292, { size: 7, color: GRAY, align: 'center' });
    fillRect(0, 295, W, 2, PINK);

    // ── Simpan ──
    const safeName = (b.nama || 'client').replace(/[^a-zA-Z0-9]/g, '_');
    const tglMU    = fmtDate(b.tanggal).replace(/\s/g, '-');
    doc.save('Invoice_' + safeName + '_' + tglMU + '.pdf');
  }
</script>

</body>
</html>
